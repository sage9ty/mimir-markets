{
  "name": "mimir",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node init && next dev",
    "dev:clean": "node init && rm -rf .next && next dev",
    "clean": "rm -rf .next",
    "build": "node init && next build",
    "typecheck": "tsc --noEmit",
    "check:terms": "node scripts/check-forbidden-terms.mjs",
    "lint": "npm run check:terms",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:node:coverage": "node scripts/run-node-tests.mjs --coverage",
    "check:locales": "node scripts/check-locale-completeness.mjs",
    "check:lockfile": "git diff --exit-code package-lock.json",
    "sbom:release": "node scripts/generate-release-sbom.mjs",
    "test:contracts": "cargo test --manifest-path contracts-soroban/Cargo.toml --release",
    "check:toolchains": "tsx scripts/check-contract-toolchains.ts",
    "rollback:rehearsal": "tsx scripts/rollback-rehearsal.ts",
    "check:schema-snapshot": "tsx scripts/check-schema-snapshot.ts",
    "start": "node init && next start",
    "oracle": "tsx --env-file-if-exists=.env.local agents/oracle/index.ts",
    "oracle:challenge": "AUTO_CHALLENGE=1 tsx --env-file-if-exists=.env.local agents/oracle/index.ts",
    "market-creator": "tsx --env-file-if-exists=.env.local agents/market-creator/index.ts",
    "council": "tsx --env-file-if-exists=.env.local agents/council/index.ts",
    "sync": "tsx --env-file-if-exists=.env.local agents/sync/index.ts",
    "traders": "tsx --env-file-if-exists=.env.local agents/traders/index.ts",
    "agents:create-wallets": "tsx scripts/create-agent-wallets.ts --write",
    "agents:fund": "tsx --env-file-if-exists=.env.local scripts/fund-agents.ts",
    "agents:distribute": "tsx --env-file-if-exists=.env.local scripts/fund-from-oracle.ts",
    "agents:funding-plan": "tsx --env-file-if-exists=.env.local scripts/fund-from-oracle.ts --dry-run",
    "agents:balances": "tsx --env-file-if-exists=.env.local scripts/check-agent-balances.ts",
    "agents:gas": "tsx --env-file-if-exists=.env.local scripts/distribute-gas.ts",
    "workers": "concurrently --names oracle,creator,council,sync,traders --kill-others-on-fail -c blue,magenta,green,cyan,yellow \"npm:oracle\" \"npm:market-creator\" \"npm:council\" \"npm:sync\" \"npm:traders\"",
    "demo:cycle": "tsx --env-file-if-exists=.env.local scripts/demo-full-cycle.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-claims.ts",
    "seed:dry": "tsx scripts/seed-claims.ts --dry-run",
    "stellar:keys": "tsx --env-file-if-exists=.env.local scripts/stellar-keys.ts",
    "stellar:usdc": "tsx --env-file-if-exists=.env.local scripts/stellar-usdc-faucet.ts",
    "stellar:bindings": "tsx --env-file-if-exists=.env.local scripts/stellar-bindings.ts",
    "deploy:contract": "tsx --env-file-if-exists=.env.local deploy/deploy.ts",
    "verify:deployment": "tsx --env-file-if-exists=.env.local scripts/verify-deployment.ts",
    "verify:artifacts": "tsx scripts/verify-artifact-provenance.ts",
    "verify:cache-backup": "node --import tsx scripts/verify-cache-backup.ts",
    "verify:release-readiness": "node --import tsx scripts/verify-release-readiness.ts",
    "verify:analytics": "tsx scripts/check-analytics-gates.ts",
    "smoke:x402": "tsx --env-file-if-exists=.env.local scripts/x402-stellar-smoke.ts",
    "smoke:x402:http": "tsx --env-file-if-exists=.env.local scripts/x402-http-smoke.ts",
    "smoke:onchain": "tsx --env-file-if-exists=.env.local scripts/onchain-smoke.ts",
    "smoke:onchain:full": "tsx --env-file-if-exists=.env.local scripts/onchain-smoke.ts --resolve --squad",
    "smoke:browser": "node scripts/run-browser-smoke.mjs",
    "test:smoke": "node scripts/run-node-tests.mjs",
    "test:coverage": "node scripts/run-coverage.mjs",
    "replay:ledger": "tsx scripts/replay-ledger-fixture.ts",
    "check:ledger-fixture": "tsx scripts/replay-ledger-fixture.ts fixtures/ledger/funded-market-v1.json",
    "check:trace": "tsx scripts/check-trace-correlation.ts",
    "test:research": "node --import tsx --test tests/node/research-adapters.test.ts tests/node/research-allowlist.test.ts tests/node/categories.test.ts tests/node/context-pack.test.ts tests/node/research-ssrf.test.ts tests/node/research-redirects.test.ts tests/node/source-fallback.test.ts tests/node/research-gateway.test.ts tests/node/x402-discovery.test.ts tests/node/evidence-fetcher-redirects.test.ts",
    "test:squad": "node --import tsx --test tests/node/squad-view.test.ts tests/node/squad-pool.test.ts",
    "test:baskets": "node --import tsx --test tests/node/baskets.test.ts",
    "test:risk": "node --import tsx --test tests/node/oracle-risk.test.ts",
    "test:schema": "node --import tsx --test tests/node/schema-backlog.test.ts tests/node/schema-snapshot.test.ts",
    "test:kill-switches": "node --import tsx --test tests/node/incident-kill-switches.test.ts tests/node/ops-flags.test.ts",
    "load:x402": "tsx scripts/load-x402-verify.ts",
    "load:rate-limit": "tsx scripts/load-rate-limit.ts",
    "warm:vs-index": "tsx scripts/warm-vs-index.ts",
    "backup:read-index": "tsx --env-file-if-exists=.env.local scripts/backup-read-index.ts",
    "restore:read-index": "tsx --env-file-if-exists=.env.local scripts/restore-read-index.ts",
    "test:migrations": "node --import tsx --test tests/node/migrations.test.ts",
    "migrate:status": "tsx scripts/migrate.ts status --fixture",
    "migrate:up": "tsx scripts/migrate.ts up --fixture",
    "migrate:down": "tsx scripts/migrate.ts down --fixture",
    "migrate:verify": "tsx scripts/migrate.ts verify --fixture",
    "check:openapi": "tsx scripts/generate-agent-openapi.ts",
    "verify:status": "tsx scripts/verify-operational-status.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@fontsource/maple-mono": "^5.2.6",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@types/ws": "^8.18.1",
    "@x402/core": "^2.21.0",
    "@x402/fetch": "^2.21.0",
    "@x402/next": "^2.21.0",
    "@xmtp/browser-sdk": "^7.0.0",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.383.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "nextjs-toploader": "^3.9.17",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sonner": "^1.7.0",
    "tsx": "^4.19.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.0",
    "c8": "^10.1.3",
    "postcss": "^8",
    "solc": "0.8.28",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "1.20.0"
  }
}
